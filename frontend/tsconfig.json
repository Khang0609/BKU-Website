{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@components": ["components/index"],
      "@components/*": ["components/*"],
      "@hooks": ["hooks/index"],
      "@hooks/*": ["hooks/*"],
      "@assets/*": ["assets/*"],
      "@constants": ["constants/index"],
      "@constants/*": ["constants/*"],
      "@context": ["context/index"],
      "@context/*": ["context/*"],
      "@lib": ["lib/index"],
      "@lib/*": ["lib/*"],
      "@local-types": ["types/index"],
      "@local-types/*": ["types/*"],
      "@styles/*": ["styles/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
